@page
@model RazorPages_cap04._19858939.Pages.Clientes.IndexModel
@{
}

<h1>Control de Clientes - Ejecicio Practico</h1>
<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Clientes Registrados</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 15%"># Num</th>
                            <th>Nombre Completo del Cliente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int contador = 1;
                        }

                        @foreach (var cliente in Model.ListaClientes)
                        {
                            <tr>
                                <td>@contador</td>
                                <td>
                                    <i class="fas fa-user text-gray-400 mr-2"></i> @cliente
                                </td>
                            </tr>
                            contador++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

